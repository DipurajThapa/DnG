# Non-secret production binding template. Do not commit real secret material.
GOLIATH_OIDC_ISSUER=https://<approved-oidc-issuer>
GOLIATH_OIDC_AUDIENCE=<approved-goliath-audience>
GOLIATH_SESSION_SECRET_REF=env:GOLIATH_SESSION_SECRET
GOLIATH_WORKER_ENABLED=true
GOLIATH_OBSERVABILITY_SINK=<approved-observability-sink>
GOLIATH_REQUIRE_TLS=true
GOLIATH_PERSISTENCE_DRIVER=postgres-sync
DATABASE_URL=<injected-by-approved-secret-manager>

# Provider examples: store only secret references in GOLIATH integration records.
# GOLIATH_JIRA_WEBHOOK_SECRET=<secret-manager-injected>
# GOLIATH_JIRA_WEBHOOK_SECRET_KEY_ID=<rotation-id>
