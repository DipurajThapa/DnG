# References and non-secret production configuration only. Never commit actual provider/session secrets.
GOLIATH_OIDC_ISSUER=https://login.example.com/tenant/v2.0
GOLIATH_OIDC_AUDIENCE=goliath-production
GOLIATH_SESSION_SECRET_REF=env:GOLIATH_SESSION_SECRET
GOLIATH_WORKER_ENABLED=true
GOLIATH_OBSERVABILITY_SINK=stdout-json
GOLIATH_REQUIRE_TLS=true
DATABASE_URL=postgresql://managed-postgres-connection-provided-at-deploy-time
GOLIATH_PERSISTENCE_DRIVER=postgres-sync

# Example provider secret injected by the hosting secret manager:
# GOLIATH_JIRA_WEBHOOK_SECRET=<managed secret material>
# GOLIATH_JIRA_WEBHOOK_SECRET_KEY_ID=2026-09-rotation-1
# Store only env:GOLIATH_JIRA_WEBHOOK_SECRET as integration_bindings_v2.secret_reference.
